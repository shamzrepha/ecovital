# Postgres connection string (Vercel > Storage > Neon adds DATABASE_URL for you)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Secret the ESP32 sends in the X-Device-Key header. Make up a long random string.
DEVICE_KEY=change-me-long-random
# Google AI Studio key (aistudio.google.com/apikey)
GEMINI_API_KEY=
# Optional overrides
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE=Kore
# Set to 1 to show the "Simulate" buttons (pitch/demo only)
NEXT_PUBLIC_DEMO=1
