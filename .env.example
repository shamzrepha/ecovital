# Postgres connection string (Vercel > Storage > Neon adds DATABASE_URL for you)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Optional. Pods no longer need a key: they enroll themselves. Set this only to keep older pods (firmware 1.4 to 1.6) working.
DEVICE_KEY=
# Signs sign-in cookies. Make up a different long random string.
SESSION_SECRET=change-me-another-long-random
# Optional: separate key for publishing firmware (defaults to DEVICE_KEY)
ADMIN_KEY=
# Google AI Studio key (aistudio.google.com/apikey). Without it the app uses built-in template advice.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
GEMINI_VOICE=Kore
