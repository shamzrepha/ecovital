# Postgres connection string (Vercel > Storage > Neon adds DATABASE_URL for you)
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
# Optional. Pods no longer need a key: they enroll themselves. Set this only to keep older pods (firmware 1.4 to 1.6) working.
DEVICE_KEY=
# Signs sign-in cookies. Make up a different long random string.
SESSION_SECRET=change-me-another-long-random
# The owner account. Only this email can be admin (publish firmware, see all users).
ROOT_ADMIN_EMAIL=shamzypre14@gmail.com
# Secret needed once, to create the owner account. Make up a long random string and keep it private.
ADMIN_SETUP_CODE=change-me-owner-setup-code
# Google AI Studio key (aistudio.google.com/apikey). Without it the app uses built-in template advice.
GEMINI_API_KEY=
# Leave these two EMPTY so the app picks Gemini 3.1 Flash-Lite and the newest speech model your key can use.
# (A value here overrides the automatic choice only if that model exists for your key.)
GEMINI_TEXT_MODEL=
GEMINI_TTS_MODEL=
GEMINI_VOICE=Kore
